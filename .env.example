# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Direct email dispatch API key from https://resend.com/
# Set your API key starting with 're_' for real, live inbox email delivery.
RESEND_API_KEY="re_your_resend_api_key_here"

# CONTACT_RECIPIENT_EMAIL: The destination email address where contact form submissions are delivered.
CONTACT_RECIPIENT_EMAIL="mdaniyalhayyat@gmail.com"

# CONTACT_SENDER_EMAIL: The verified sender email address on Resend (e.g. onboarding@resend.dev or mail@dnyl.dev)
CONTACT_SENDER_EMAIL="DNYL Inquiries <onboarding@resend.dev>"

# VITE_WHATSAPP_PHONE_NUMBER: Central WhatsApp number for direct messaging (international format without '+')
VITE_WHATSAPP_PHONE_NUMBER="923331001904"
